# E-mail de confirmação de reserva (EmailJS) — ver src/lib/email.js
#
# Passos:
#  1. Crie uma conta grátis em https://www.emailjs.com e ligue um serviço de
#     e-mail (Gmail, Outlook, etc.) em Email Services.
#  2. Crie um template em Email Templates com estas variáveis (ligue-as ao
#     "To email" do template como {{to_email}}):
#       {{to_name}} {{codigo_reserva}} {{nome_propriedade}} {{apartamento}}
#       {{check_in}} {{check_out}} {{total}} {{sinal}} {{sinal_pct}}
#       {{endereco}} {{whatsapp}}
#  3. Copie os três valores abaixo de Account → General (Public Key) e
#     Email Services / Email Templates (Service ID / Template ID).
#  4. Copie este ficheiro para ".env" (que não vai para o Git) para testar
#     localmente com "npm run dev".
#  5. Para funcionar no site publicado, adicione as mesmas três variáveis em
#     Vercel → Settings → Environment Variables, e faça um novo deploy.
#
# Sem estas variáveis o site funciona normalmente, só não envia o e-mail.

VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

# Sincronização de dados entre dispositivos (Supabase) — ver src/lib/supabaseClient.js
#
# Passos:
#  1. Crie uma conta grátis em https://supabase.com e um novo projeto.
#  2. Em Project Settings → API, copie o "Project URL" e a chave pública
#     "anon public" (NÃO a "service_role", essa é secreta).
#  3. No SQL Editor do projeto, cole e execute o ficheiro supabase-setup.sql
#     (na raiz deste repositório) para criar a tabela e as permissões.
#  4. Copie este ficheiro para ".env" (que não vai para o Git) para testar
#     localmente com "npm run dev".
#  5. Para funcionar no site publicado, adicione as mesmas duas variáveis em
#     Vercel → Settings → Environment Variables, e faça um novo deploy.
#
# Sem estas variáveis o site funciona normalmente, só que cada dispositivo
# volta a ter a sua própria cópia dos dados (sem sincronizar entre eles).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

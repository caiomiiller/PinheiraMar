# Copie para ".env" (não vai para o Git) para testar no seu computador.
# Sem nenhuma variável, "npm run dev" abre o site em modo demonstração
# (dados fictícios guardados só no navegador).
# Na Vercel, as mesmas variáveis vão em Settings → Environment Variables.
# Ver README.md → "Variáveis de ambiente".

# ── Vão para o navegador (prefixo VITE_): NUNCA ponha segredos aqui ──

# Supabase → Project Settings → API: "Project URL" e a chave "anon public"
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional — só no ambiente Preview da Vercel: faixa "ambiente de testes"
VITE_AMBIENTE=
# Opcional — build de demonstração, sem banco (prévias). Nunca em produção.
VITE_MODO_DEMO=

# ── Só no servidor (funções da pasta api/) — SECRETAS, sem VITE_ ──

# Supabase → Project Settings → API → "service_role". As funções leem e
# gravam o banco com ela. Nunca a use no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago → Suas integrações → Credenciais → Access Token.
# Sem ela, as reservas do site seguem pelo fluxo manual (pendentes).
MP_ACCESS_TOKEN=

# Opcional: domínio do site para os retornos do Mercado Pago
# (sem isto, usa o domínio por onde o site foi aberto).
SITE_URL=

# EmailJS (e-mail de confirmação — enviado só pelo servidor).
# Account → General (Public Key) · Email Services (Service ID) ·
# Email Templates (Template ID) · Account → API keys (Private Key).
# Em Account → Security ligar "Allow EmailJS API for non-browser applications".
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
EMAILJS_PRIVATE_KEY=
